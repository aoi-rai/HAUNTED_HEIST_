#include <stdio.h>
#include <SDL2/SDL.h>
#include <GL/glew.h>
#include <math.h>
#include <time.h>
#include <stdlib.h>
#include <SDL2/SDL_image.h>

#include "model2.h"
#include "room2.h"
#include "shader2.h"
#include "furniture2.h"
#include "npc2.h"
#include "map_random2.h"
#include "camera2.h"
#include "map_display2.h"

// カメラの種類
#define CAMERA_EDITOR 0
#define CAMERA_PLAYER 1

#define PI 3.14159265f

// ----------------------------------------
// ベクトルの正規化
// ----------------------------------------
int main(int argc, char *argv[])
{
    (void)argc;
    (void)argv;

    // 乱数の初期化
    srand((unsigned int)time(NULL));

    // 草の配置情報
GrassPosition grasses[GRASS_COUNT];

    // ------------------------------------
    // SDLの初期化
    // ------------------------------------
    if (SDL_Init(SDL_INIT_VIDEO) < 0) {
        printf("SDL初期化失敗: %s\n", SDL_GetError());
        return 1;
    }

    // PNG画像読み込みの初期化
    if ((IMG_Init(IMG_INIT_PNG) & IMG_INIT_PNG) == 0) {
        printf("SDL_image初期化失敗: %s\n", IMG_GetError());
        SDL_Quit();
        return 1;
    }

    printf("PNG画像読み込みの初期化成功\n");

    // ------------------------------------
    // OpenGLの設定
    // ------------------------------------
    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 2);
    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 1);

    // ウィンドウの作成
    SDL_Window *window = SDL_CreateWindow(
        "HAUNTED HEIST",
        SDL_WINDOWPOS_CENTERED,
        SDL_WINDOWPOS_CENTERED,
        1000,
        720,
        SDL_WINDOW_OPENGL | SDL_WINDOW_SHOWN
    );

    if (window == NULL) {
        printf("ウィンドウ作成失敗: %s\n", SDL_GetError());

        IMG_Quit();
        SDL_Quit();
        return 1;
    }

    // OpenGLコンテキスト作成
    SDL_GLContext context = SDL_GL_CreateContext(window);

    if (context == NULL) {
        printf("OpenGL初期化失敗: %s\n", SDL_GetError());

        SDL_DestroyWindow(window);
        IMG_Quit();
        SDL_Quit();
        return 1;
    }

    // GLEWの初期化
    GLenum glewResult = glewInit();

    if (glewResult != GLEW_OK) {
        printf(
            "GLEW初期化失敗: %s\n",
            glewGetErrorString(glewResult)
        );

        SDL_GL_DeleteContext(context);
        SDL_DestroyWindow(window);
        IMG_Quit();
        SDL_Quit();
        return 1;
    }

    printf("GLEWの初期化成功\n");

    SDL_GL_SetSwapInterval(1);

    glViewport(0, 0, 1000, 720);

    glClearColor(0.05f, 0.10f, 0.08f, 1.0f);

    glEnable(GL_DEPTH_TEST);

    printf("HAUNTED HEIST 起動\n");

    // ------------------------------------
    // シェーダーの読み込み
    // ------------------------------------
    unsigned int shaderProgram = LoadShaders(
        "shaders/vertex.glsl",
        "shaders/fragment.glsl"
    );

    if (shaderProgram == 0) {
        printf("シェーダー読み込み失敗\n");

        SDL_GL_DeleteContext(context);
        SDL_DestroyWindow(window);
        IMG_Quit();
        SDL_Quit();
        return 1;
    }

    printf("シェーダーの読み込み成功\n");

    // ------------------------------------
    // 部屋・家具・NPCの初期化
    // ------------------------------------
    InitRooms();
    InitFurniture();
    InitNPCs();

    // ------------------------------------
    // マップ変更タイマー
    // ------------------------------------
    Uint32 lastMapChange = SDL_GetTicks();

    const Uint32 MAP_CHANGE_INTERVAL = 30000;

    // ------------------------------------
    // モデルの読み込み
    // ------------------------------------
    int largeRoomID =
        LoadModel("models/mansion/oohiroma.fbx");

    int smallRoomID =
        LoadModel("models/mansion/kobeya.fbx");

    int playerModelID =
        LoadModel("models/ghost.fbx");

        int birchTreeID =
    LoadModel("models/nature/FBX/BirchTree_1.fbx");

    printf("木モデルID: %d\n", birchTreeID);

    int bushID =
    LoadModel("models/nature/FBX/Bush.fbx");

    int rockIDs[5];

rockIDs[0] = LoadModel("models/nature/FBX/Rock_1.fbx");
rockIDs[1] = LoadModel("models/nature/FBX/Rock_2.fbx");
rockIDs[2] = LoadModel("models/nature/FBX/Rock_3.fbx");
rockIDs[3] = LoadModel("models/nature/FBX/Rock_4.fbx");
rockIDs[4] = LoadModel("models/nature/FBX/Rock_5.fbx");

// 草モデル
int grassID = LoadModel("models/nature/FBX/Grass_Small.fbx");

// 花モデル
int flowerIDs[5];

flowerIDs[0] = LoadModel("models/nature/FBX/Flower_1_Clump.fbx");
flowerIDs[1] = LoadModel("models/nature/FBX/Flower_2_Clump.fbx");
flowerIDs[2] = LoadModel("models/nature/FBX/Flower_3_Clump.fbx");
flowerIDs[3] = LoadModel("models/nature/FBX/Flower_4_Clump.fbx");
flowerIDs[4] = LoadModel("models/nature/FBX/Flower_5_Clump.fbx");

    if (largeRoomID == 0 ||
    smallRoomID == 0 ||
    playerModelID == 0 ||
    birchTreeID == 0 ||
    bushID == 0) {
        printf("モデル読み込み失敗\n");

        FreeModel(largeRoomID);
        FreeModel(smallRoomID);
        FreeModel(playerModelID);
        FreeShaders(shaderProgram);

        SDL_GL_DeleteContext(context);
        SDL_DestroyWindow(window);
        IMG_Quit();
        SDL_Quit();
        return 1;
    }

    for (int i = 0; i < 5; i++) {
    if (rockIDs[i] == 0) {
        printf("岩モデル読み込み失敗: %d\n", i + 1);
        return 1;
    }
}

if (grassID == 0) {
    printf("草モデル読み込み失敗\n");
    return 1;
}

for (int i = 0; i < 5; i++) {
    if (flowerIDs[i] == 0) {
        printf("花モデル読み込み失敗: %d\n", i + 1);
        return 1;
    }
}

// ====================================
// 草の配置情報を初期化（400か所）
// ====================================

for (int i = 0; i < GRASS_COUNT; i++) {

    float t = (float)rand() / (float)RAND_MAX;
    float offset = -39.0f + t * 78.0f;

    float side = (float)rand() / (float)RAND_MAX;

    if (side < 0.25f) {
        grasses[i].x = -39.0f;
        grasses[i].z = offset;
    }
    else if (side < 0.5f) {
        grasses[i].x = 39.0f;
        grasses[i].z = offset;
    }
    else if (side < 0.75f) {
        grasses[i].x = offset;
        grasses[i].z = -39.0f;
    }
    else {
        grasses[i].x = offset;
        grasses[i].z = 39.0f;
    }

    grasses[i].scale =
        0.022f + ((float)rand() / (float)RAND_MAX) * 0.008f;

    grasses[i].rotation = (float)(rand() % 360);
}

    // ------------------------------------
    // プレイヤーの初期位置
    // ------------------------------------
    float playerX = 0.0f;
    float playerY = 0.0f;
    float playerZ = 0.0f;

    GetPlayerStartPosition(
        &playerX,
        &playerY,
        &playerZ
    );

    // プレイヤーモデルの大きさ
    float playerScale = 0.01f;

    // プレイヤーの向き
    float playerDirection = 1.5707963f;
    float playerTargetDirection = 1.5707963f;

    // 旋回速度
    const float playerRotationSpeed = PI;

    // ------------------------------------
    // 部屋の情報を確認
    // ------------------------------------
    for (int i = 0; i < ROOM_COUNT; i++) {

        Room room = GetRoom(i);

        printf(
            "部屋%d: X=%.1f Z=%.1f 幅=%.1f 奥行=%.1f\n",
            room.roomID,
            room.x,
            room.z,
            room.width,
            room.depth
        );
    }

    // ------------------------------------
    // カメラ設定
    // ------------------------------------
    float view[16];
    float projection[16];

    int cameraMode = CAMERA_PLAYER;

// マップ表示モード
// 0 = 周辺マップ
// 1 = 全体マップ
int mapMode = 0;

    float cameraYaw = 0.0f;
    float cameraPitch = 0.0f;

    // NPC選択情報
    int selectedNPCID = -1;
    int previousSelectedNPCID = -2;

    // 初期カメラ行列
    Update3DCamera(
        view,
        cameraMode,
        playerX,
        playerY,
        playerZ,
        cameraYaw,
        cameraPitch
    );

    // ------------------------------------
    // 透視投影行列
    // ------------------------------------
    CreatePerspective(
        projection,
        60.0f,
        1000.0f / 720.0f,
        0.1f,
        200.0f
    );

    // ------------------------------------
    // シェーダー設定
    // ------------------------------------
    glUseProgram(shaderProgram);

    glUniformMatrix4fv(
        glGetUniformLocation(shaderProgram, "view"),
        1,
        GL_FALSE,
        view
    );

    glUniformMatrix4fv(
        glGetUniformLocation(shaderProgram, "projection"),
        1,
        GL_FALSE,
        projection
    );

    // ------------------------------------
    // メインループ
    // ------------------------------------
    int running = 1;

    SDL_Event event;

    Uint32 previousTime = SDL_GetTicks();

    while (running) {

        // ====================================
        // イベント処理
        // ====================================
        while (SDL_PollEvent(&event)) {

            if (event.type == SDL_QUIT) {
                running = 0;
            }

            /// Xキーでマップ切り替え
if (event.type == SDL_KEYDOWN &&
    event.key.repeat == 0 &&
    event.key.keysym.sym == SDLK_x) {

    mapMode = 1 - mapMode;

    if (mapMode == 0) {
        printf("周辺マップに切り替え\n");
    } else {
        printf("全体マップに切り替え\n");
    }
}
        }

        // ====================================
        // 経過時間
        // ====================================
        Uint32 currentTime = SDL_GetTicks();

        float deltaTime =
            (currentTime - previousTime) / 1000.0f;

        previousTime = currentTime;

        // ====================================
        // NPCの移動更新
        // ====================================
        UpdateNPCs(deltaTime);

        // キーボード入力
        const Uint8 *keys = SDL_GetKeyboardState(NULL);

        // ====================================
        // WASDでカメラ操作
        // ====================================
        if (cameraMode == CAMERA_PLAYER) {

            float cameraRotateSpeed = 2.0f * deltaTime;

            // 左右
            if (keys[SDL_SCANCODE_D]) {
                cameraYaw -= cameraRotateSpeed;
            }

            if (keys[SDL_SCANCODE_A]) {
                cameraYaw += cameraRotateSpeed;
            }

            // 上下
            if (keys[SDL_SCANCODE_W]) {
                cameraPitch += cameraRotateSpeed;
            }

            if (keys[SDL_SCANCODE_S]) {
                cameraPitch -= cameraRotateSpeed;
            }

            // 上下の回転範囲
            if (cameraPitch > 1.2f) {
                cameraPitch = 1.2f;
            }

            if (cameraPitch < -1.2f) {
                cameraPitch = -1.2f;
            }
        }

        // カメラの向きにプレイヤーの向きを合わせる
playerTargetDirection = atan2f(
    -cosf(cameraYaw),
    -sinf(cameraYaw)
);

        // ====================================
        // 方向キーでプレイヤー移動
        // ====================================
        float moveX = 0.0f;
        float moveZ = 0.0f;

        // カメラの向いている方向
        float forwardX = -sinf(cameraYaw);
        float forwardZ = -cosf(cameraYaw);

        // カメラから見た右方向
        float rightX = cosf(cameraYaw);
        float rightZ = -sinf(cameraYaw);

        if (cameraMode == CAMERA_PLAYER) {

            // 前進
            if (keys[SDL_SCANCODE_UP]) {
                moveX += forwardX;
                moveZ += forwardZ;
            }

            // 後退
            if (keys[SDL_SCANCODE_DOWN]) {
                moveX -= forwardX;
                moveZ -= forwardZ;
            }

            // 左移動
            if (keys[SDL_SCANCODE_LEFT]) {
                moveX -= rightX;
                moveZ -= rightZ;
            }

            // 右移動
            if (keys[SDL_SCANCODE_RIGHT]) {
                moveX += rightX;
                moveZ += rightZ;
            }
        }

        // 移動速度
        float moveSpeed = 5.0f;

        // 斜め移動の速度調整
        float moveLength = sqrtf(
            moveX * moveX +
            moveZ * moveZ
        );

        if (moveLength > 0.0f) {

            playerX +=
                (moveX / moveLength) *
                moveSpeed *
                deltaTime;

            playerZ +=
                (moveZ / moveLength) *
                moveSpeed *
                deltaTime;

            // 移動方向を目標角度にする
            playerTargetDirection = atan2f(
                -moveZ,
                moveX
            );
        }

        // ====================================
        // プレイヤーの滑らかな旋回
        // ====================================
        {
            const float TWO_PI = 6.28318530f;

            float angleDifference =
                playerTargetDirection - playerDirection;

            while (angleDifference > PI) {
                angleDifference -= TWO_PI;
            }

            while (angleDifference < -PI) {
                angleDifference += TWO_PI;
            }

            float maxTurn =
                playerRotationSpeed * deltaTime;

            if (fabsf(angleDifference) <= maxTurn) {

                playerDirection = playerTargetDirection;

            } else if (angleDifference > 0.0f) {

                playerDirection += maxTurn;

            } else {

                playerDirection -= maxTurn;
            }

            // 角度を -PI ～ PI に収める
            while (playerDirection > PI) {
                playerDirection -= TWO_PI;
            }

            while (playerDirection < -PI) {
                playerDirection += TWO_PI;
            }
        }

        // ====================================
// 30秒ごとのマップ変更
// ====================================
if (currentTime - lastMapChange >= MAP_CHANGE_INTERVAL) {

    printf("\n===== マップを変更します =====\n");

    // 変更前の部屋情報を保存
    Room oldRooms[ROOM_COUNT];

    for (int i = 0; i < ROOM_COUNT; i++) {
        oldRooms[i] = GetRoom(i);
    }

    // 部屋の配置をランダム変更
    RandomizeRooms();

    // 各小部屋の移動量を計算
    for (int i = 1; i < ROOM_COUNT; i++) {

        Room oldRoom = oldRooms[i];
        Room newRoom = GetRoom(i);

        float dx = newRoom.x - oldRoom.x;
        float dz = newRoom.z - oldRoom.z;

        // NPCを移動
        MoveNPCsWithRoom(
            i,
            oldRoom.x,
            oldRoom.z,
            oldRoom.width,
            oldRoom.depth,
            dx,
            dz
        );

        // プレイヤーが変更前の部屋にいるか確認
        float minX = oldRoom.x - oldRoom.width / 2.0f;
        float maxX = oldRoom.x + oldRoom.width / 2.0f;
        float minZ = oldRoom.z - oldRoom.depth / 2.0f;
        float maxZ = oldRoom.z + oldRoom.depth / 2.0f;

        if (playerX >= minX && playerX <= maxX &&
            playerZ >= minZ && playerZ <= maxZ) {

            playerX += dx;
            playerZ += dz;

            printf("プレイヤーが部屋%dと一緒に移動しました\n", i);
        }

        printf(
            "部屋%d: X=%.1f Z=%.1f 移動量X=%.1f Z=%.1f\n",
            i,
            newRoom.x,
            newRoom.z,
            dx,
            dz
        );
    }

    lastMapChange = currentTime;

    printf("===== マップ変更完了 =====\n");
}

        // ====================================
        // カメラの更新
        // ====================================
        Update3DCamera(
            view,
            cameraMode,
            playerX,
            playerY,
            playerZ,
            cameraYaw,
            cameraPitch
        );

        // ====================================
        // NPCの選択対象を更新
        // ====================================
        selectedNPCID = FindTargetNPC(
            cameraMode,
            playerX,
            playerY,
            playerZ,
            cameraYaw,
            cameraPitch
        );

        // 選択対象が変わったときだけ表示
        if (selectedNPCID != previousSelectedNPCID) {

            if (selectedNPCID >= 0) {

                printf(
                    "選択中のNPC: %d\n",
                    selectedNPCID
                );

            } else {

                if (cameraMode == CAMERA_PLAYER) {
                    printf("NPCの選択解除\n");
                }
            }

            previousSelectedNPCID = selectedNPCID;
        }

        // ====================================
        // シェーダー設定
        // ====================================
        glUseProgram(shaderProgram);

        glUniformMatrix4fv(
            glGetUniformLocation(shaderProgram, "view"),
            1,
            GL_FALSE,
            view
        );

        glUniformMatrix4fv(
            glGetUniformLocation(shaderProgram, "projection"),
            1,
            GL_FALSE,
            projection
        );

        // ====================================
// 画面全体をクリア
// ====================================
glViewport(0, 0, 1000, 720);

glClear(
    GL_COLOR_BUFFER_BIT |
    GL_DEPTH_BUFFER_BIT
);

// ====================================
// 右側をゲーム画面にする
// ====================================
glViewport(0, 0, 1000, 720);

        // ====================================
        // 大広間の描画
        // ====================================
        DrawModelAt(
            largeRoomID,
            shaderProgram,
            0.0f,
            0.0f,
            0.0f,
            1.98f
        );

        // ====================================
        // 小部屋の描画
        // ====================================
        for (int i = 1; i < ROOM_COUNT; i++) {

            Room room = GetRoom(i);

            DrawModelAt(
                smallRoomID,
                shaderProgram,
                room.x,
                0.0f,
                room.z,
                1.98f
            );
        }

// ====================================
// 木の配置（合計120本）
// ====================================

TreePosition trees[120];
int treeCount = 0;

// 左右の辺に15本ずつ配置
for (int i = 0; i < 30; i++) {
    float z = -35.0f + i * (70.0f / 29.0f);

    // 少し位置をずらして自然にする
    z += (float)((i % 3) - 1) * 1.0f;

    float scale = 0.018f + (i % 5) * 0.001f;
    float rotation = i * 0.71f;

    // 左側
    trees[treeCount++] = (TreePosition){
        -37.0f, z, rotation, scale
    };

    // 右側
    trees[treeCount++] = (TreePosition){
        37.0f, z, rotation + 1.2f, scale
    };
}

// 奥側と手前側に15本ずつ配置
for (int i = 0; i < 30; i++) {
    float x = -35.0f + i * (70.0f / 29.0f);

    x += (float)((i % 3) - 1) * 1.0f;

    float scale = 0.018f + (i % 5) * 0.001f;
    float rotation = i * 0.83f;

    // 奥側
    trees[treeCount++] = (TreePosition){
        x, -37.0f, rotation, scale
    };

    // 手前側
    trees[treeCount++] = (TreePosition){
        x, 37.0f, rotation + 1.5f, scale
    };
}

// ====================================
// 木の描画（60本）
// ====================================

for (int i = 0; i < treeCount; i++) {

    DrawModelAtRotated(
        birchTreeID,
        shaderProgram,
        trees[i].x,
        0.0f,
        trees[i].z,
        trees[i].scale,
        trees[i].rotation
    );
}

// ====================================
// 外周の低木の描画
// ====================================

typedef struct {
    float x;
    float z;
    float rotation;
    float scale;
} BushPosition;

BushPosition bushes[24];
int bushCount = 0;

// 左右の外周
for (int i = 0; i < 6; i++) {

    float z = -32.0f + i * 12.0f;

    bushes[bushCount++] = (BushPosition){
        -32.0f, z, i * 0.7f, 0.012f
    };

    bushes[bushCount++] = (BushPosition){
        32.0f, z + 4.0f, i * 1.1f, 0.012f
    };
}

// 奥側と手前側
for (int i = 0; i < 6; i++) {

    float x = -32.0f + i * 12.0f;

    bushes[bushCount++] = (BushPosition){
        x, -32.0f, i * 0.8f, 0.012f
    };

    bushes[bushCount++] = (BushPosition){
        x + 4.0f, 32.0f, i * 1.2f, 0.012f
    };
}

// 低木を描画
for (int i = 0; i < bushCount; i++) {

    DrawModelAtRotated(
        bushID,
        shaderProgram,
        bushes[i].x,
        0.0f,
        bushes[i].z,
        bushes[i].scale,
        bushes[i].rotation
    );
}

// ====================================
// 外周の岩の描画
// ====================================

typedef struct {
    float x;
    float z;
    float rotation;
    float scale;
    int modelIndex;
} RockPosition;

RockPosition rocks[30];
int rockCount = 0;

// 左右の外周
for (int i = 0; i < 8; i++) {

    float z = -35.0f + i * 10.0f;

    rocks[rockCount++] = (RockPosition){
        -34.0f, z, i * 0.7f,
        0.010f + (i % 3) * 0.003f,
        i % 5
    };

    rocks[rockCount++] = (RockPosition){
        34.0f, z + 3.0f, i * 1.1f,
        0.010f + (i % 3) * 0.003f,
        (i + 2) % 5
    };
}

// 奥側と手前側
for (int i = 0; i < 7; i++) {

    float x = -30.0f + i * 10.0f;

    rocks[rockCount++] = (RockPosition){
        x, -34.0f, i * 0.8f,
        0.010f + (i % 3) * 0.003f,
        (i + 1) % 5
    };

    if (i < 7) {
        rocks[rockCount++] = (RockPosition){
            x + 3.0f, 34.0f, i * 1.2f,
            0.010f + (i % 3) * 0.003f,
            (i + 3) % 5
        };
    }
}

// 岩を描画
for (int i = 0; i < rockCount; i++) {

    DrawModelAtRotated(
        rockIDs[rocks[i].modelIndex],
        shaderProgram,
        rocks[i].x,
        0.0f,
        rocks[i].z,
        rocks[i].scale,
        rocks[i].rotation
    );
}

/// ====================================
// 草の描画（400か所）
// ====================================

for (int i = 0; i < GRASS_COUNT; i++) {

    DrawModelAtRotated(
        grassID,
        shaderProgram,
        grasses[i].x,
        0.0f,
        grasses[i].z,
        grasses[i].scale,
        grasses[i].rotation
    );
}


// ====================================
// 花の配置
// ====================================

typedef struct {
    float x;
    float z;
    int type;
    float scale;
    float rotation;
} FlowerPosition;

FlowerPosition flowers[25] = {
