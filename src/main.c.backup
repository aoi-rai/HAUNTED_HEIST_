#include <stdio.h>
#include <SDL2/SDL.h>
#include <GL/glew.h>
#include <math.h>
#include <time.h>
#include <stdlib.h>
#include <SDL2/SDL_image.h>

#include "model2.h"
#include "room2.h"
#include "shader2.h"
#include "furniture2.h"
#include "npc2.h"
#include "map_random2.h"
#include "camera2.h"
#include "map_display2.h"
#include "environment2.h"
#include "player2.h"

// カメラの種類
#define CAMERA_EDITOR 0
#define CAMERA_PLAYER 1

#define PI 3.14159265f

// ----------------------------------------
// ベクトルの正規化
// ----------------------------------------
int main(int argc, char *argv[])
{
    (void)argc;
    (void)argv;

    // 乱数の初期化
    srand((unsigned int)time(NULL));


    // ------------------------------------
    // SDLの初期化
    // ------------------------------------
    if (SDL_Init(SDL_INIT_VIDEO) < 0) {
        printf("SDL初期化失敗: %s\n", SDL_GetError());
        return 1;
    }

    // PNG画像読み込みの初期化
    if ((IMG_Init(IMG_INIT_PNG) & IMG_INIT_PNG) == 0) {
        printf("SDL_image初期化失敗: %s\n", IMG_GetError());
        SDL_Quit();
        return 1;
    }

    printf("PNG画像読み込みの初期化成功\n");

    // ------------------------------------
    // OpenGLの設定
    // ------------------------------------
    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 2);
    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 1);

    // ウィンドウの作成
    SDL_Window *window = SDL_CreateWindow(
        "HAUNTED HEIST",
        SDL_WINDOWPOS_CENTERED,
        SDL_WINDOWPOS_CENTERED,
        1000,
        720,
        SDL_WINDOW_OPENGL | SDL_WINDOW_SHOWN
    );

    if (window == NULL) {
        printf("ウィンドウ作成失敗: %s\n", SDL_GetError());

        IMG_Quit();
        SDL_Quit();
        return 1;
    }

    // OpenGLコンテキスト作成
    SDL_GLContext context = SDL_GL_CreateContext(window);

    if (context == NULL) {
        printf("OpenGL初期化失敗: %s\n", SDL_GetError());

        SDL_DestroyWindow(window);
        IMG_Quit();
        SDL_Quit();
        return 1;
    }

    // GLEWの初期化
    GLenum glewResult = glewInit();

    if (glewResult != GLEW_OK) {
        printf(
            "GLEW初期化失敗: %s\n",
            glewGetErrorString(glewResult)
        );

        SDL_GL_DeleteContext(context);
        SDL_DestroyWindow(window);
        IMG_Quit();
        SDL_Quit();
        return 1;
    }

    printf("GLEWの初期化成功\n");

    SDL_GL_SetSwapInterval(1);

    glViewport(0, 0, 1000, 720);

    glClearColor(0.05f, 0.10f, 0.08f, 1.0f);

    glEnable(GL_DEPTH_TEST);

    printf("HAUNTED HEIST 起動\n");

    // ------------------------------------
    // シェーダーの読み込み
    // ------------------------------------
    unsigned int shaderProgram = LoadShaders(
        "shaders/vertex.glsl",
        "shaders/fragment.glsl"
    );

    if (shaderProgram == 0) {
        printf("シェーダー読み込み失敗\n");

        SDL_GL_DeleteContext(context);
        SDL_DestroyWindow(window);
        IMG_Quit();
        SDL_Quit();
        return 1;
    }

    printf("シェーダーの読み込み成功\n");

    // ------------------------------------
    // 部屋・家具・NPCの初期化
    // ------------------------------------
    InitRooms();
    InitFurniture();
    InitNPCs();

    // ------------------------------------
    // マップ変更タイマー
    // ------------------------------------
    Uint32 lastMapChange = SDL_GetTicks();

    const Uint32 MAP_CHANGE_INTERVAL = 30000;

    // ------------------------------------
    // モデルの読み込み
    // ------------------------------------
    int largeRoomID =
        LoadModel("models/mansion/oohiroma.fbx");

    int smallRoomID =
        LoadModel("models/mansion/kobeya.fbx");

    int playerModelID =
        LoadModel("models/ghost.fbx");


    if (largeRoomID == 0 ||
    smallRoomID == 0 ||
    playerModelID == 0) {
        printf("モデル読み込み失敗\n");

        FreeModel(largeRoomID);
        FreeModel(smallRoomID);
        FreeModel(playerModelID);
        FreeShaders(shaderProgram);

        SDL_GL_DeleteContext(context);
        SDL_DestroyWindow(window);
        IMG_Quit();
        SDL_Quit();
        return 1;
    }

    // ------------------------------------
    // 環境オブジェクトの初期化
    // ------------------------------------
    if (!InitEnvironment()) {
        printf("環境オブジェクトの初期化失敗\n");
        FreeModel(largeRoomID);
        FreeModel(smallRoomID);
        FreeModel(playerModelID);
        FreeShaders(shaderProgram);
        SDL_GL_DeleteContext(context);
        SDL_DestroyWindow(window);
        IMG_Quit();
        SDL_Quit();
        return 1;
    }

    // ------------------------------------
    // プレイヤーの初期位置
    // ------------------------------------
    float playerX = 0.0f;
    float playerY = 0.0f;
    float playerZ = 0.0f;

    GetPlayerStartPosition(
        &playerX,
        &playerY,
        &playerZ
    );

    // プレイヤーモデルの大きさ
    float playerScale = 0.01f;

    // プレイヤーの向き
    float playerDirection = 1.5707963f;
    float playerTargetDirection = 1.5707963f;

    // 旋回速度
    const float playerRotationSpeed = PI;

    // ------------------------------------
    // 部屋の情報を確認
    // ------------------------------------
    for (int i = 0; i < ROOM_COUNT; i++) {

        Room room = GetRoom(i);

        printf(
            "部屋%d: X=%.1f Z=%.1f 幅=%.1f 奥行=%.1f\n",
            room.roomID,
            room.x,
            room.z,
            room.width,
            room.depth
        );
    }

    // ------------------------------------
    // カメラ設定
    // ------------------------------------
    float view[16];
    float projection[16];

    int cameraMode = CAMERA_PLAYER;

// マップ表示モード
// 0 = 周辺マップ
// 1 = 全体マップ
int mapMode = 0;

    float cameraYaw = 0.0f;
    float cameraPitch = 0.0f;

    // NPC選択情報
    int selectedNPCID = -1;
    int previousSelectedNPCID = -2;

    // 初期カメラ行列
    Update3DCamera(
        view,
        cameraMode,
        playerX,
        playerY,
        playerZ,
        cameraYaw,
        cameraPitch
    );

    // ------------------------------------
    // 透視投影行列
    // ------------------------------------
    CreatePerspective(
        projection,
        60.0f,
        1000.0f / 720.0f,
        0.1f,
        200.0f
    );

    // ------------------------------------
    // シェーダー設定
    // ------------------------------------
    glUseProgram(shaderProgram);

    glUniformMatrix4fv(
        glGetUniformLocation(shaderProgram, "view"),
        1,
        GL_FALSE,
        view
    );

    glUniformMatrix4fv(
        glGetUniformLocation(shaderProgram, "projection"),
        1,
        GL_FALSE,
        projection
    );

    // ------------------------------------
    // メインループ
    // ------------------------------------
    int running = 1;

    SDL_Event event;

    Uint32 previousTime = SDL_GetTicks();

    while (running) {

        // ====================================
        // イベント処理
        // ====================================
        while (SDL_PollEvent(&event)) {

            if (event.type == SDL_QUIT) {
                running = 0;
            }

            /// Xキーでマップ切り替え
if (event.type == SDL_KEYDOWN &&
    event.key.repeat == 0 &&
    event.key.keysym.sym == SDLK_x) {

    mapMode = 1 - mapMode;

    if (mapMode == 0) {
        printf("周辺マップに切り替え\n");
    } else {
        printf("全体マップに切り替え\n");
    }
}
        }

        // ====================================
        // 経過時間
        // ====================================
        Uint32 currentTime = SDL_GetTicks();

        float deltaTime =
            (currentTime - previousTime) / 1000.0f;

        previousTime = currentTime;

        // ====================================
        // NPCの移動更新
        // ====================================
        UpdateNPCs(deltaTime);

        // キーボード入力
        const Uint8 *keys = SDL_GetKeyboardState(NULL);

        // ====================================
        // WASDでカメラ操作
        // ====================================
        if (cameraMode == CAMERA_PLAYER) {

            float cameraRotateSpeed = 2.0f * deltaTime;

            // 左右
            if (keys[SDL_SCANCODE_D]) {
                cameraYaw -= cameraRotateSpeed;
            }

            if (keys[SDL_SCANCODE_A]) {
                cameraYaw += cameraRotateSpeed;
            }

            // 上下
            if (keys[SDL_SCANCODE_W]) {
                cameraPitch += cameraRotateSpeed;
            }

            if (keys[SDL_SCANCODE_S]) {
                cameraPitch -= cameraRotateSpeed;
            }

            // 上下の回転範囲
            if (cameraPitch > 1.2f) {
                cameraPitch = 1.2f;
            }

            if (cameraPitch < -1.2f) {
                cameraPitch = -1.2f;
            }
        }

        // プレイヤーの移動・旋回更新
        UpdatePlayerMovement(
            keys,
            cameraMode,
            cameraYaw,
            deltaTime,
            playerRotationSpeed,
            &playerX,
            &playerZ,
            &playerDirection,
            &playerTargetDirection
        );

        // ====================================
// 30秒ごとのマップ変更
// ====================================
if (currentTime - lastMapChange >= MAP_CHANGE_INTERVAL) {

    printf("\n===== マップを変更します =====\n");

    // 変更前の部屋情報を保存
    Room oldRooms[ROOM_COUNT];

    for (int i = 0; i < ROOM_COUNT; i++) {
        oldRooms[i] = GetRoom(i);
    }

    // 部屋の配置をランダム変更
    RandomizeRooms();

    // 各小部屋の移動量を計算
    for (int i = 1; i < ROOM_COUNT; i++) {

        Room oldRoom = oldRooms[i];
        Room newRoom = GetRoom(i);

        float dx = newRoom.x - oldRoom.x;
        float dz = newRoom.z - oldRoom.z;

        // NPCを移動
        MoveNPCsWithRoom(
            i,
            oldRoom.x,
            oldRoom.z,
            oldRoom.width,
            oldRoom.depth,
            dx,
            dz
        );

        // プレイヤーが変更前の部屋にいるか確認
        float minX = oldRoom.x - oldRoom.width / 2.0f;
        float maxX = oldRoom.x + oldRoom.width / 2.0f;
        float minZ = oldRoom.z - oldRoom.depth / 2.0f;
        float maxZ = oldRoom.z + oldRoom.depth / 2.0f;

        if (playerX >= minX && playerX <= maxX &&
            playerZ >= minZ && playerZ <= maxZ) {

            playerX += dx;
            playerZ += dz;

            printf("プレイヤーが部屋%dと一緒に移動しました\n", i);
        }

        printf(
            "部屋%d: X=%.1f Z=%.1f 移動量X=%.1f Z=%.1f\n",
            i,
            newRoom.x,
            newRoom.z,
            dx,
            dz
        );
    }

    lastMapChange = currentTime;

    printf("===== マップ変更完了 =====\n");
}

        // ====================================
        // カメラの更新
        // ====================================
        Update3DCamera(
            view,
            cameraMode,
            playerX,
            playerY,
            playerZ,
            cameraYaw,
            cameraPitch
        );

        // ====================================
        // NPCの選択対象を更新
        // ====================================
        selectedNPCID = FindTargetNPC(
            cameraMode,
            playerX,
            playerY,
            playerZ,
            cameraYaw,
            cameraPitch
        );

        // 選択対象が変わったときだけ表示
        if (selectedNPCID != previousSelectedNPCID) {

            if (selectedNPCID >= 0) {

                printf(
                    "選択中のNPC: %d\n",
                    selectedNPCID
                );

            } else {

                if (cameraMode == CAMERA_PLAYER) {
                    printf("NPCの選択解除\n");
                }
            }

            previousSelectedNPCID = selectedNPCID;
        }

        // ====================================
        // シェーダー設定
        // ====================================
        glUseProgram(shaderProgram);

        glUniformMatrix4fv(
            glGetUniformLocation(shaderProgram, "view"),
            1,
            GL_FALSE,
            view
        );

        glUniformMatrix4fv(
            glGetUniformLocation(shaderProgram, "projection"),
            1,
            GL_FALSE,
            projection
        );

        // ====================================
// 画面全体をクリア
// ====================================
glViewport(0, 0, 1000, 720);

glClear(
    GL_COLOR_BUFFER_BIT |
    GL_DEPTH_BUFFER_BIT
);

// ====================================
// 右側をゲーム画面にする
// ====================================
glViewport(0, 0, 1000, 720);

        // ====================================
        // 大広間の描画
        // ====================================
        DrawModelAt(
            largeRoomID,
            shaderProgram,
            0.0f,
            0.0f,
            0.0f,
            1.98f
        );

        // ====================================
        // 小部屋の描画
        // ====================================
        for (int i = 1; i < ROOM_COUNT; i++) {

            Room room = GetRoom(i);

            DrawModelAt(
                smallRoomID,
                shaderProgram,
                room.x,
                0.0f,
                room.z,
                1.98f
            );
        }

        // 環境オブジェクトの描画
        DrawEnvironment(shaderProgram);

// ====================================
// NPCの描画
// ====================================
DrawNPCs(
    playerModelID,
    shaderProgram,
    selectedNPCID,
    playerScale
);

        // ====================================
        // プレイヤーモデルの描画
        // ====================================
        // 制作・確認用カメラのときだけ描画
        if (cameraMode == CAMERA_EDITOR &&
            playerModelID != 0) {

            DrawModelAtRotated(
                playerModelID,
                shaderProgram,
                playerX,
                playerY,
                playerZ,
                playerScale,
                playerDirection
            );
        }

        // 一人称カメラのとき照準を表示
if (cameraMode == CAMERA_PLAYER) {
    DrawReticle(selectedNPCID >= 0);
}

// ====================================
// 左側のマップを描画
// ====================================
DrawMap(
    mapMode,
    playerX,
    playerZ,
    cameraYaw
);

        // ====================================
        // 画面更新
        // ====================================
        SDL_GL_SwapWindow(window);
    }

    // ========================================
    // 終了処理
    // ========================================

    FreeModel(largeRoomID);
FreeModel(smallRoomID);
FreeModel(playerModelID);
    FreeEnvironment();

    FreeShaders(shaderProgram);

    SDL_GL_DeleteContext(context);
    SDL_DestroyWindow(window);

    IMG_Quit();
    SDL_Quit();

    return 0;
}