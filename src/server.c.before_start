#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/select.h>

#define PORT 50000
#define MAX_PLAYERS 4
#define BUFFER_SIZE 1024

/*データを最後まで送信する関数*/
int send_all(int fd, const char *data, int length)
{
    int total = 0;

    while (total < length) {
        int sent = send(fd, data + total, length - total, MSG_NOSIGNAL);

        if (sent <= 0) {
            return -1;
        }

        total += sent;
    }

    return 0;
}

/*プレイヤーを切断状態にする関数*/
void disconnect_player(
    int client_fds[],
    int ready[],
    char line_buffers[][BUFFER_SIZE],
    int line_lengths[],
    int index
)
{
    if (client_fds[index] != -1) {
        printf("Player %d を切断しました。\n", index + 1);
        close(client_fds[index]);
        client_fds[index] = -1;
    }

    ready[index] = 0;
    line_lengths[index] = 0;
    line_buffers[index][0] = '\0';
}

/*待機画面の状態を全員に通知する関数*/
void broadcast_status(int client_fds[], int ready[])
{
    char message[BUFFER_SIZE];

    /*送信失敗による切断がなくなるまで状態を通知*/
    while (1) {
        int count = 0;
        int can_start = 1;

        for (int i = 0; i < MAX_PLAYERS; i++) {
            if (client_fds[i] != -1) {
                count++;

                if (!ready[i]) {
                    can_start = 0;
                }
            }
        }

        /*2人未満では開始できない*/
        if (count < 2) {
            can_start = 0;
        }

        int length = snprintf(
            message,
            sizeof(message),
            "STATUS,%d,%d,%d,%d,%d,%d\n",
            count,
            ready[0],
            ready[1],
            ready[2],
            ready[3],
            can_start
        );

        if (length <= 0 || length >= (int)sizeof(message)) {
            return;
        }

        int disconnected = 0;

        for (int i = 0; i < MAX_PLAYERS; i++) {
            if (client_fds[i] != -1) {
                if (send_all(client_fds[i], message, length) < 0) {
                    printf("Player %d への状態通知に失敗しました。\n", i + 1);

                    close(client_fds[i]);
                    client_fds[i] = -1;
                    ready[i] = 0;
                    disconnected = 1;
                }
            }
        }

        if (!disconnected) {
            break;
        }
    }
}

/*全プレイヤーにメッセージを配信する関数*/
void broadcast_message(
    int client_fds[],
    int ready[],
    char line_buffers[][BUFFER_SIZE],
    int line_lengths[],
    const char *message,
    int length
)
{
    int disconnected = 0;

    for (int i = 0; i < MAX_PLAYERS; i++) {
        if (client_fds[i] != -1) {
            if (send_all(client_fds[i], message, length) < 0) {
                printf("Player %d への送信が失敗しました。\n", i + 1);

                disconnect_player(
                    client_fds,
                    ready,
                    line_buffers,
                    line_lengths,
                    i
                );

                disconnected = 1;
            }
        }
    }

    if (disconnected) {
        broadcast_status(client_fds, ready);
    }
}

/*クライアントから受信した1行を処理する関数*/
void process_message(
    int client_fds[],
    int ready[],
    char line_buffers[][BUFFER_SIZE],
    int line_lengths[],
    int player_index,
    const char *buffer
)
{
    char message[BUFFER_SIZE + 64];

    printf("Player %d: %s\n", player_index + 1, buffer);

    /*準備完了*/
    if (strcmp(buffer, "READY") == 0) {
        ready[player_index] = 1;
        broadcast_status(client_fds, ready);
    }
    /*準備解除*/
    else if (strcmp(buffer, "UNREADY") == 0) {
        ready[player_index] = 0;
        broadcast_status(client_fds, ready);
    }
    /*位置情報など、その他のメッセージ*/
    else {
        int length = snprintf(
            message,
            sizeof(message),
            "Player %d: %s\n",
            player_index + 1,
            buffer
        );

        if (length > 0 && length < (int)sizeof(message)) {
            broadcast_message(
                client_fds,
                ready,
                line_buffers,
                line_lengths,
                message,
                length
            );
        }
    }
}

int main(void)
{
    int server_fd;
    int client_fds[MAX_PLAYERS];
    int ready[MAX_PLAYERS] = {0};

    /*TCPの複数メッセージ受信に対応するバッファ*/
    char line_buffers[MAX_PLAYERS][BUFFER_SIZE] = {{0}};
    int line_lengths[MAX_PLAYERS] = {0};

    struct sockaddr_in server_addr;
    struct sockaddr_in client_addr;
    fd_set read_fds;

    char receive_buffer[BUFFER_SIZE];

    /*クライアント管理用配列の初期化*/
    for (int i = 0; i < MAX_PLAYERS; i++) {
        client_fds[i] = -1;
    }

    /*ソケットの作成*/
    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd < 0) {
        perror("socket");
        return 1;
    }

    /*ポート番号の再利用を許可*/
    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    /*サーバーのアドレス設定*/
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    /*ポート番号割当*/
    if (bind(server_fd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("bind");
        close(server_fd);
        return 1;
    }

    /*接続待機*/
    if (listen(server_fd, MAX_PLAYERS) < 0) {
        perror("listen");
        close(server_fd);
        return 1;
    }

    printf("サーバーを起動しました。\n");
    printf("最大プレイヤー数：%d\n", MAX_PLAYERS);

    /*通信管理ループ*/
    while (1) {
        FD_ZERO(&read_fds);

        FD_SET(server_fd, &read_fds);
        int max_fd = server_fd;

        /*接続中のクライアントを監視対象に追加*/
        for (int i = 0; i < MAX_PLAYERS; i++) {
            if (client_fds[i] != -1) {
                FD_SET(client_fds[i], &read_fds);

                if (client_fds[i] > max_fd) {
                    max_fd = client_fds[i];
                }
            }
        }

        /*通信開始まで待機*/
        int activity = select(max_fd + 1, &read_fds, NULL, NULL, NULL);

        if (activity < 0) {
            perror("select");
            break;
        }

        /*新しい接続が来たか確認*/
        if (FD_ISSET(server_fd, &read_fds)) {
            socklen_t client_len = sizeof(client_addr);

            int new_fd = accept(
                server_fd,
                (struct sockaddr *)&client_addr,
                &client_len
            );

            if (new_fd < 0) {
                perror("accept");
            }
            else {
                int slot = -1;

                for (int i = 0; i < MAX_PLAYERS; i++) {
                    if (client_fds[i] == -1) {
                        slot = i;
                        break;
                    }
                }

                if (slot == -1) {
                    const char *full_message = "Server is full\n";
                    send_all(new_fd, full_message, strlen(full_message));
                    close(new_fd);

                    printf("プレイヤー数が上限に達したため、接続を拒否しました。\n");
                }
                else {
                    client_fds[slot] = new_fd;
                    ready[slot] = 0;
                    line_lengths[slot] = 0;
                    line_buffers[slot][0] = '\0';

                    printf("Player %d が接続しました。\n", slot + 1);

                    /*プレイヤーIDを送信*/
                    char id_message[BUFFER_SIZE];

                    snprintf(
                        id_message,
                        sizeof(id_message),
                        "PLAYER_ID:%d\n",
                        slot + 1
                    );

                    if (send_all(new_fd, id_message, strlen(id_message)) < 0) {
                        disconnect_player(
                            client_fds,
                            ready,
                            line_buffers,
                            line_lengths,
                            slot
                        );
                    }

                    broadcast_status(client_fds, ready);
                }
            }
        }

        /*接続中のプレイヤーからの通信を確認*/
        for (int i = 0; i < MAX_PLAYERS; i++) {
            int fd = client_fds[i];

            if (fd == -1 || !FD_ISSET(fd, &read_fds)) {
                continue;
            }

            int received = recv(
                fd,
                receive_buffer,
                sizeof(receive_buffer),
                0
            );

            if (received <= 0) {
                disconnect_player(
                    client_fds,
                    ready,
                    line_buffers,
                    line_lengths,
                    i
                );

                broadcast_status(client_fds, ready);
                continue;
            }

            /*受信データを改行単位で処理*/
            for (int j = 0; j < received; j++) {
                char c = receive_buffer[j];

                if (c == '\n') {
                    line_buffers[i][line_lengths[i]] = '\0';

                    /*末尾のCRを除去*/
                    if (line_lengths[i] > 0 &&
                        line_buffers[i][line_lengths[i] - 1] == '\r') {
                        line_buffers[i][line_lengths[i] - 1] = '\0';
                    }

                    process_message(
                        client_fds,
                        ready,
                        line_buffers,
                        line_lengths,
                        i,
                        line_buffers[i]
                    );

                    line_lengths[i] = 0;
                    line_buffers[i][0] = '\0';

                    /*処理中に切断された場合*/
                    if (client_fds[i] == -1) {
                        break;
                    }
                }
                else {
                    if (line_lengths[i] >= BUFFER_SIZE - 1) {
                        printf("Player %d のメッセージが長すぎます。\n", i + 1);

                        disconnect_player(
                            client_fds,
                            ready,
                            line_buffers,
                            line_lengths,
                            i
                        );

                        broadcast_status(client_fds, ready);
                        break;
                    }

                    line_buffers[i][line_lengths[i]] = c;
                    line_lengths[i]++;
                }
            }
        }
    }

    /*通信終了*/
    for (int i = 0; i < MAX_PLAYERS; i++) {
        if (client_fds[i] != -1) {
            close(client_fds[i]);
        }
    }

    close(server_fd);

    printf("サーバーを終了しました。\n");

    return 0;
}
