#include <stdio.h>
#include <SDL2/SDL.h>
#include <GL/glew.h>
#include <math.h>
#include <time.h>
#include <stdlib.h>

#include "model2.h"
#include "room2.h"
#include "shader2.h"
#include "furniture2.h"
#include "npc2.h"
#include "map_random2.h"
#include "camera2.h"
#include "map_display2.h"
#include "environment2.h"
#include "player2.h"
#include "map_update2.h"
#include "game_render2.h"
#include "game_init2.h"
#include "model_init2.h"
#include "window2.h"
#include "input2.h"
#include "target2.h"

// カメラの種類
#define CAMERA_EDITOR 0
#define CAMERA_PLAYER 1

#define PI 3.14159265f

// ----------------------------------------
// ベクトルの正規化
// ----------------------------------------
int main(int argc, char *argv[])
{
    (void)argc;
    (void)argv;

    // 乱数の初期化
    srand((unsigned int)time(NULL));


    // ------------------------------------
    // ウィンドウ・OpenGLの初期化
    WindowContext appWindow;

    if (!InitWindow(&appWindow)) {
        return 1;
    }

    // 既存処理との互換性のため変数名を維持
    SDL_Window *window = appWindow.window;

    // ------------------------------------
    // シェーダーの読み込み
    // ------------------------------------
    unsigned int shaderProgram = LoadShaders(
        "shaders/vertex.glsl",
        "shaders/fragment.glsl"
    );

    if (shaderProgram == 0) {
        printf("シェーダー読み込み失敗\n");

        CloseWindow(&appWindow);
        return 1;
    }

    printf("シェーダーの読み込み成功\n");

    // ------------------------------------
    // マップ変更タイマー
    // ------------------------------------
    Uint32 lastMapChange = SDL_GetTicks();

    const Uint32 MAP_CHANGE_INTERVAL = 30000;

    // ------------------------------------
    // モデルの読み込み
    int largeRoomID = 0;
    int smallRoomID = 0;
    int playerModelID = 0;

    if (!InitGameModels(
        &largeRoomID,
        &smallRoomID,
        &playerModelID
    )) {
        FreeModel(largeRoomID);
        FreeModel(smallRoomID);
        FreeModel(playerModelID);
        FreeShaders(shaderProgram);

        CloseWindow(&appWindow);
        return 1;
    }

    // ------------------------------------
    // ゲームワールド全体の初期化
    // ------------------------------------
    if (!InitGameWorld()) {
        FreeModel(largeRoomID);
        FreeModel(smallRoomID);
        FreeModel(playerModelID);
        FreeShaders(shaderProgram);

        CloseWindow(&appWindow);
        return 1;
    }

    // ------------------------------------
    // ------------------------------------
    // ゲーム状態の初期化
    // ------------------------------------
    GameInitData game;
    InitGameState(&game, shaderProgram);

    // 既存のゲームループからゲーム状態にアクセスするための別名
    #define playerX game.playerX
    #define playerY game.playerY
    #define playerZ game.playerZ
    #define playerScale game.playerScale
    #define playerDirection game.playerDirection
    #define playerTargetDirection game.playerTargetDirection
    #define playerRotationSpeed game.playerRotationSpeed

    #define view game.view
    #define projection game.projection
    #define cameraMode game.cameraMode
    #define cameraYaw game.cameraYaw
    #define cameraPitch game.cameraPitch

    #define mapMode game.mapMode
    #define selectedNPCID game.selectedNPCID
    #define previousSelectedNPCID game.previousSelectedNPCID

    // メインループ
    // ------------------------------------
    int running = 1;

    SDL_Event event;

    Uint32 previousTime = SDL_GetTicks();

    while (running) {

        // ====================================
        // イベント処理
        // ====================================
        HandleInputEvents(&running, &mapMode);

        // ====================================
        // 経過時間
        // ====================================
        Uint32 currentTime = SDL_GetTicks();

        float deltaTime =
            (currentTime - previousTime) / 1000.0f;

        previousTime = currentTime;

        // ====================================
        // NPCの移動更新
        // ====================================
        UpdateNPCs(deltaTime);

        // キーボード入力
        const Uint8 *keys = GetInputKeys();

        // ====================================
        // カメラ操作
        // ====================================
        UpdateCameraInput(
            keys,
            cameraMode,
            deltaTime,
            &cameraYaw,
            &cameraPitch
        );

        // プレイヤーの移動・旋回更新
        UpdatePlayerMovement(
            keys,
            cameraMode,
            cameraYaw,
            deltaTime,
            playerRotationSpeed,
            &playerX,
            &playerZ,
            &playerDirection,
            &playerTargetDirection
        );

        // ====================================
// 30秒ごとのマップ変更
        UpdateMap(
            currentTime,
            &lastMapChange,
            MAP_CHANGE_INTERVAL,
            &playerX,
            &playerZ
        );

        // カメラの更新
        // ====================================
        Update3DCamera(
            view,
            cameraMode,
            playerX,
            playerY,
            playerZ,
            cameraYaw,
            cameraPitch
        );

        // ====================================
        // NPCの選択対象を更新
        // ====================================
        UpdateTargetNPC(
            cameraMode,
            playerX,
            playerY,
            playerZ,
            cameraYaw,
            cameraPitch,
            &selectedNPCID,
            &previousSelectedNPCID
        );

        // ====================================
        // シェーダー設定
        // ====================================
        glUseProgram(shaderProgram);

        glUniformMatrix4fv(
            glGetUniformLocation(shaderProgram, "view"),
            1,
            GL_FALSE,
            view
        );

        glUniformMatrix4fv(
            glGetUniformLocation(shaderProgram, "projection"),
            1,
            GL_FALSE,
            projection
        );

        // ====================================
// ゲーム画面の描画
        DrawGameScene(
            largeRoomID,
            smallRoomID,
            playerModelID,
            shaderProgram,
            cameraMode,
            selectedNPCID,
            playerX,
            playerY,
            playerZ,
            playerScale,
            playerDirection
        );

        // 一人称カメラのとき照準を表示
if (cameraMode == CAMERA_PLAYER) {
    DrawReticle(selectedNPCID >= 0);
}

// ====================================
// 左側のマップを描画
// ====================================
DrawMap(
    mapMode,
    playerX,
    playerZ,
    cameraYaw
);

        // ====================================
        // 画面更新
        // ====================================
        SDL_GL_SwapWindow(window);
    }

    // ========================================
    // 終了処理
    // ========================================

    FreeModel(largeRoomID);
FreeModel(smallRoomID);
FreeModel(playerModelID);
    FreeEnvironment();

    FreeShaders(shaderProgram);

    CloseWindow(&appWindow);

    return 0;
}