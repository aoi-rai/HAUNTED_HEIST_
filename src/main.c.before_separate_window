}

    // 3D背景を描画
    SetShaderMatrices(
        shaderProgram,
        view,
        projection
    );

    DrawGameScene(
        largeRoomID,
        smallRoomID,
        playerModelID,
        shaderProgram,
        CAMERA_EDITOR,
        -1,
        playerX,
        playerY,
        playerZ,
        playerScale,
        playerDirection
    );

    // 2D看板を重ねて表示
