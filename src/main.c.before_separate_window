        guideSelection--;

        if (guideSelection < 0) {
            guideSelection = 2;
        }
    }

    if (WasKeyPressed(SDLK_RIGHT)) {
        guideSelection++;

        if (guideSelection > 2) {
            guideSelection = 0;
        }
    }

    // Enterキーで選択した画面へ移動
if (WasKeyPressed(SDLK_RETURN) ||
    WasKeyPressed(SDLK_KP_ENTER)) {

