}

// ====================================
// ゲーム開始カウントダウン
// ====================================
if (screenState == SCREEN_COUNTDOWN) {

    Uint32 elapsed = SDL_GetTicks() - countdownStartTime;

    if (elapsed >= 4000) {
        /*ゲーム開始時点から30秒を計測する*/
        lastMapChange = SDL_GetTicks();

        screenState = SCREEN_GAME;
        previousTime = currentTime;
        continue;
    }

    SetShaderMatrices(shaderProgram, view, projection);

    DrawGameScene(
        largeRoomID,
        smallRoomID,
        playerModelID,
        shaderProgram,
        CAMERA_EDITOR,
        -1,
        playerX,
        playerY,
        playerZ,
        playerScale,
        playerDirection
    );

    DrawRemotePlayers(
        playerModelID,
        shaderProgram,
        playerScale
    );

    if (elapsed < 1000) {
        DrawTextCentered("3", 330, 110);
    } else if (elapsed < 2000) {
        DrawTextCentered("2", 330, 110);
    } else if (elapsed < 3000) {
        DrawTextCentered("1", 330, 110);
    } else {
        DrawTextCentered("START!", 330, 80);
    }

    SDL_GL_SwapWindow(window);
    continue;
}

// ====================================
// ここから下は既存のゲーム処理
// ====================================

// ゲーム状態の更新
UpdateGameFrame(
            &game,
            keys,
            deltaTime
        );

        // ====================================
// ネットワーク通信
// ====================================
if (networkConnected) {

    // プレイヤー1だけが30秒ごとに新しいMAP配置を送信
    if (screenState == SCREEN_GAME &&
        Network_GetPlayerID() == 1 &&
        currentTime - lastMapChange >= MAP_CHANGE_INTERVAL) {

        float positions[ROOM_COUNT][2] = {{0}};
        char mapSendBuffer[512];

        GenerateMapLayout(positions);

        int offset = snprintf(
            mapSendBuffer,
            sizeof(mapSendBuffer),
            "MAP"
        );

        int valid = (offset >= 0 && offset < (int)sizeof(mapSendBuffer));

        for (int i = 1; i < ROOM_COUNT && valid; i++) {
            int written = snprintf(
                mapSendBuffer + offset,
                sizeof(mapSendBuffer) - offset,
                ",%.1f,%.1f",
                positions[i][0],
                positions[i][1]
            );

            if (written < 0 ||
                written >= (int)(sizeof(mapSendBuffer) - offset)) {
                valid = 0;
            } else {
                offset += written;
            }
        }

        if (valid) {
            int written = snprintf(
                mapSendBuffer + offset,
                sizeof(mapSendBuffer) - offset,
                "\n"
            );

            if (written < 0 ||
                written >= (int)(sizeof(mapSendBuffer) - offset)) {
                valid = 0;
            }
        }

        if (valid) {
            if (Network_Send(mapSendBuffer) < 0) {
                printf("MAP情報の送信に失敗しました。\n");
                networkConnected = 0;
            } else {
                printf("新しいMAP配置をサーバーへ送信しました。\n");

                // 連続送信を防止
                lastMapChange = currentTime;
            }
        } else {
            printf("MAP送信データの作成に失敗しました。\n");
        }
    }

    // 100ミリ秒ごとに自分の位置を送信
    if (currentTime - lastNetworkSend >= 100) {

        char sendBuffer[160];

        snprintf(
            sendBuffer,
            sizeof(sendBuffer),
            "STATE,%d,%.3f,%.3f,%.3f,%.3f\n",
            Network_GetPlayerID(),
            playerX,
            playerY,
            playerZ,
            playerDirection
        );

        if (Network_Send(sendBuffer) < 0) {
            printf("位置情報の送信に失敗しました。\n");
            networkConnected = 0;
        }

        lastNetworkSend = currentTime;
    }

    // 他プレイヤーの位置情報を受信
    if (networkConnected) {
        char receiveBuffer[1024];
        int received;

        while ((received = Network_Receive(
            receiveBuffer,
            sizeof(receiveBuffer)
        )) > 0) {

            int senderID;
            int dataPlayerID;

            float x, y, z, direction;

            /*ホストから届いたMAP配置情報*/
            const char *mapPrefix = "Player 1: MAP,";

            if (strncmp(
                receiveBuffer,
                mapPrefix,
                strlen(mapPrefix)
            ) == 0) {

                const char *cursor = receiveBuffer + strlen(mapPrefix);
                float positions[ROOM_COUNT][2] = {{0}};
                int valid = 1;

                // 12部屋分のX・Z座標を読み取る
                for (int roomID = 1;
                     roomID < ROOM_COUNT && valid;
                     roomID++) {

                    char *end;

                    positions[roomID][0] = strtof(cursor, &end);

                    if (end == cursor || *end != ',') {
                        valid = 0;
                        break;
                    }

                    cursor = end + 1;

                    positions[roomID][1] = strtof(cursor, &end);

                    if (end == cursor) {
                        valid = 0;
                        break;
                    }

                    cursor = end;

                    if (roomID < ROOM_COUNT - 1) {
                        if (*cursor != ',') {
                            valid = 0;
                            break;
                        }

                        cursor++;
                    }
                }

                // 最後の改行を読み飛ばす
                while (*cursor == '\n' || *cursor == '\r') {
                    cursor++;
                }

                if (valid && *cursor == '\0') {
                    printf("ホストからMAP配置を受信しました。\n");

                    ApplyMapLayout(
                        positions,
                        currentTime,
                        &lastMapChange,
                        &playerX,
                        &playerZ
                    );
                } else {
                    printf("MAP受信データの形式が正しくありません。\n");
                }

                continue;
            }

            /*他プレイヤーの切断通知*/
            int disconnectedID;

            if (sscanf(
                receiveBuffer,
                "DISCONNECT,%d",
                &disconnectedID
            ) == 1) {
                RemoveRemotePlayer(disconnectedID);
                printf("プレイヤー%dが切断しました。\\n", disconnectedID);
                continue;
            }

            // サーバーから届く形式：
            // Player 2: STATE,2,1.000,0.000,2.000,90.000

            if (sscanf(
                receiveBuffer,
                "Player %d: STATE,%d,%f,%f,%f,%f",
                &senderID,
                &dataPlayerID,
                &x,
                &y,
                &z,
                &direction
            ) == 6) {

                // 自分以外のプレイヤーだけ更新
                if (senderID != Network_GetPlayerID()
                    && senderID == dataPlayerID
                    && senderID >= 1
                    && senderID <= 4) {

                    SetRemotePlayerState(
                        senderID,
                        x,
                        y,
                        z,
                        direction
                    );
                }
            }
        }

        if (received < 0) {
            printf("サーバーとの通信が終了しました。\n");
            networkConnected = 0;
        }
    }
}

        // 他プレイヤーの表示位置を滑らかに更新
        UpdateRemotePlayers(deltaTime);

        // Spaceキーで選択中のNPCにアクション
// 行動不能中はアクションできない
if (spacePressed && game.immobilizedTimer <= 0.0f) {
    HandleNPCAction(&game);
}

        // シェーダー設定
        SetShaderMatrices(
            shaderProgram,
            view,
            projection
        );

        // ====================================
// ゲーム画面の描画
        DrawGameScene(
            largeRoomID,
            smallRoomID,
            playerModelID,
            shaderProgram,
            cameraMode,
            selectedNPCID,
            playerX,
            playerY,
            playerZ,
            playerScale,
            playerDirection
        );

                // 他プレイヤーの描画
        DrawRemotePlayers(
            playerModelID,
            shaderProgram,
            playerScale
        );

        // 盲目状態の画面暗転
        DrawBlindnessOverlay(game.blindnessTimer);

        // UI描画
        DrawGameUI(
            cameraMode,
            selectedNPCID,
            mapMode,
            playerX,
            playerZ,
            cameraYaw
        );

        // ====================================
        // 画面更新
        // ====================================
        SDL_GL_SwapWindow(window);
    }

Network_Close();

// UIの終了処理
CleanupUI();

    // ========================================
    // 終了処理
    // ========================================

    CleanupGame(
        largeRoomID,
        smallRoomID,
        playerModelID,
        waitingPlayerModelID,
        shaderProgram,
        &appWindow
    );

    return 0;
}
