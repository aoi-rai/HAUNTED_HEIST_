    DrawText2D(
        guideSelection == 0 ? "> 操作説明 <" : "  操作説明  ",
        180, 400, 30
    );

    DrawText2D(
        guideSelection == 1 ? "> コンセプト <" : "  コンセプト  ",
        430, 400, 30
    );

    DrawText2D(
        guideSelection == 2 ? "> 次へ <" : "  次へ  ",
        720, 400, 30
    );

    DrawTextCentered("LEFT / RIGHT : SELECT", 550, 20);
    DrawTextCentered("ENTER : DECIDE", 590, 20);

    SDL_GL_SwapWindow(window);
    continue;
}

// ====================================
// 待機画面
// ====================================
if (screenState == SCREEN_WAITING) {

    /*ESCキーでガイド画面に戻る*/
    if (WasKeyPressed(SDLK_ESCAPE)) {
        if (networkConnected && myReady) {
            Network_Send("UNREADY\n");
            myReady = 0;
        }

        screenState = SCREEN_GUIDE;
    }

    /*接続失敗時はRキーで再接続*/
    if (!networkConnected && WasKeyPressed(SDLK_r)) {
        if (Network_Connect("127.0.0.1", 50000) < 0) {
            printf("サーバーへの再接続に失敗しました。\n");
        } else {
            networkConnected = 1;
            myReady = 0;
            waitingPlayerCount = 0;
            waitingCanStart = 0;
            startRequestSent = 0;

            for (int i = 0; i < 4; i++) {
                waitingReady[i] = 0;
            }

            printf("サーバーへの再接続に成功しました。プレイヤーID：%d\n",
                   Network_GetPlayerID());
        }
    }

    /*サーバーから待機状態を受信*/
    if (networkConnected) {
        char receiveBuffer[256];
        int received;

        while ((received = Network_Receive(
            receiveBuffer,
            sizeof(receiveBuffer)
        )) > 0) {

            printf("[CLIENT RECEIVE] %s\n", receiveBuffer);

            /*サーバーからゲーム開始通知を受信*/
            if (strncmp(receiveBuffer, "START", 5) == 0) {
                countdownStartTime = SDL_GetTicks();
                screenState = SCREEN_COUNTDOWN;
                printf("ゲーム開始通知を受信しました。\n");
                break;
            }

            int count;
            int ready1, ready2, ready3, ready4;
            int canStart;

            /*待機状態の通知*/
            if (sscanf(
                receiveBuffer,
                "STATUS,%d,%d,%d,%d,%d,%d",
                &count,
                &ready1,
                &ready2,
                &ready3,
                &ready4,
                &canStart
            ) == 6) {

                waitingPlayerCount = count;
                waitingReady[0] = ready1;
                waitingReady[1] = ready2;
                waitingReady[2] = ready3;
                waitingReady[3] = ready4;
                waitingCanStart = canStart;

                myReady = waitingReady[Network_GetPlayerID() - 1];
            }
        }

        if (received < 0) {
            printf("サーバーとの通信が終了しました。\n");
            networkConnected = 0;
            myReady = 0;
            waitingCanStart = 0;
            startRequestSent = 0;
        }
    }

    if (screenState == SCREEN_COUNTDOWN) {
        continue;
    }

    /*Rキーで準備完了・準備解除*/
    if (networkConnected && WasKeyPressed(SDLK_r)) {
        if (myReady) {
            if (Network_Send("UNREADY\n") < 0) {
                networkConnected = 0;
                myReady = 0;
            }
        } else {
            if (Network_Send("READY\n") < 0) {
                networkConnected = 0;
            }
        }
    }

    /*Player 1だけがゲーム開始を要求する*/
    if (networkConnected &&
        waitingCanStart &&
        !startRequestSent &&
        Network_GetPlayerID() == 1 &&
        (WasKeyPressed(SDLK_RETURN) ||
         WasKeyPressed(SDLK_KP_ENTER))) {

        if (Network_Send("START\n") < 0) {
            printf("ゲーム開始要求の送信に失敗しました。\n");
            networkConnected = 0;
        } else {
            startRequestSent = 1;
            printf("ゲーム開始要求を送信しました。\n");
        }
    }

    /*3Dのお化け屋敷を背景に表示*/
    SetShaderMatrices(
        shaderProgram,
        view,
        projection
    );

    DrawGameScene(
        largeRoomID,
        smallRoomID,
        playerModelID,
        shaderProgram,
        CAMERA_EDITOR,
        -1,
        playerX,
        playerY,
        playerZ,
        playerScale,
        playerDirection
    );

    /*待機画面専用プレイヤーを横一列に表示*/
    {
        const float rightX = 0.83205f;
        const float rightZ = -0.55470f;

        const float centerX = 0.0f;
        const float centerZ = 0.0f;

        int displayCount = waitingPlayerCount;

        if (displayCount > 4) {
            displayCount = 4;
        }

        for (int i = 0; i < displayCount; i++) {
            float offset =
                (i - (displayCount - 1) * 0.5f) * 2.0f;

            DrawModelAtRotated(
                waitingPlayerModelID,
                shaderProgram,
                centerX + rightX * offset,
                0.0f,
                centerZ + rightZ * offset,
                1.0f,
                0.0f
            );
        }
    }

    /*待機画面の表示*/
    DrawTextCentered("WAITING ROOM", 75, 48);

    if (networkConnected) {
        char text[128];

        snprintf(
            text,
            sizeof(text),
            "PLAYER ID : %d",
            Network_GetPlayerID()
        );
        DrawTextCentered(text, 145, 26);

        snprintf(
            text,
            sizeof(text),
            "参加人数 : %d / 4",
            waitingPlayerCount
        );
        DrawTextCentered(text, 205, 26);

        /*各プレイヤーの準備状態*/
        for (int i = 0; i < 4; i++) {
            if (waitingReady[i]) {
                snprintf(text, sizeof(text),
                         "PLAYER %d : READY", i + 1);
            } else {
                snprintf(text, sizeof(text),
                         "PLAYER %d : WAITING", i + 1);
            }

            DrawTextCentered(text, 275 + i * 55, 24);
        }

        if (myReady) {
            DrawTextCentered("あなたは準備完了です！", 510, 26);
        } else {
            DrawTextCentered("R : 準備完了にする", 510, 26);
        }

        if (waitingCanStart) {
            DrawTextCentered("全員準備完了！", 565, 28);

            if (Network_GetPlayerID() == 1) {
                DrawTextCentered("ENTER : ゲーム開始", 610, 24);
            } else {
                DrawTextCentered("PLAYER 1の開始を待っています", 610, 24);
            }
        } else {
            DrawTextCentered("全員の準備を待っています...", 565, 24);
        }
    }
    else {
        DrawTextCentered("サーバーに接続できませんでした", 300, 28);
        DrawTextCentered("R : 再接続", 380, 26);
    }

    DrawTextCentered("ESC : ガイドに戻る", 675, 20);

    SDL_GL_SwapWindow(window);
    continue;
}

// ====================================
// 操作説明画面
// ====================================
if (screenState == SCREEN_CONTROLS) {

